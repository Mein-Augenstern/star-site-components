<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xp.starsite</groupId>
    <artifactId>star-site-components</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>starsite-async-command-mybatis</artifactId>
  <name>starsite-async-command-mybatis</name>
  <description>异步命令 MyBatis 适配：MyBatis 注解式 Mapper + Store 实现——消费方classpath有MyBatis即优先装配，无则零感知</description>

  <dependencies>
    <!-- 被适配的 core（store 接口与模型） -->
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-async-command</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- starter（Properties 在这里；provided——消费方引 starter 时自然有） -->
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-async-command-spring-boot-starter</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- sequence 组件（物理主键标准来源；provided 不传递） -->
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-sequence-spring-boot-starter</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- MyBatis（provided：由消费方classpath提供，本模块不传递强制依赖） -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <version>3.5.14</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis-spring</artifactId>
      <version>3.0.3</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- 测试（H2 内存库 + spring-boot-starter-test 的 EmbeddedDatabaseBuilder） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
