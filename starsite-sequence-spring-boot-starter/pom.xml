<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xp.starsite</groupId>
    <artifactId>star-site-components</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>starsite-sequence-spring-boot-starter</artifactId>
  <name>starsite-sequence-spring-boot-starter</name>
  <description>雪花序列 starter：自动装配（单机/分布式）+ 健康端点，引 jar + 配置即用（测试见 starsite-sequence-tests）</description>

  <dependencies>
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-sequence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- actuator 存在时装配健康端点（可选依赖，不强制引入） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
