<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xp.starsite</groupId>
    <artifactId>star-site-components</artifactId>
    <version>0.2.2</version>
  </parent>

  <artifactId>starsite-lock-spring-boot-starter</artifactId>
  <name>starsite-lock-spring-boot-starter</name>
  <description>分布式锁 starter：自动装配（db/redis 双模式）+ 健康端点，引 jar + 配置即用</description>

  <dependencies>
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-lock</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 锁行/命令表主键来源（compile 传递：单独引本组件也能工作，无需手工加 sequence 依赖） -->
    <dependency>
      <groupId>com.xp.starsite</groupId>
      <artifactId>starsite-sequence-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- DB 模式需要 mybatis-spring（@MapperScan 注册 Mapper 用；provided 不传递） -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis-spring</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Redis 模式（optional：无 Redis 消费方零感知） -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
      <version>3.2.4</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
